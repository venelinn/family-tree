{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Family Tree",
  "version": "0.1.0",
  "identifier": "com.venelinnikolov.familytree",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3022",
    "beforeDevCommand": "pnpm dev:tauri",
    "beforeBuildCommand": "pnpm build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Family Tree",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5MzUxNUJGRUZDMUM4NzgKUldSNHlNSHZ2eFUxT1FVcnpRc0ROVWhmOHl5Z0JXbEZEd2I5ZkNIemp5MnYwQmtLck1tcFFTcTYK",
      "endpoints": [
        "https://github.com/venelinn/family-tree/releases/latest/download/latest.json"
      ]
    }
  }
}
